# Leenardo Supabase Draft Writer Credentials
# Used by scripts/upload_drafts.mjs to authenticate via Supabase Auth
# Run with: node --env-file=.env scripts/upload_drafts.mjs <file.json> [--confirm]

DRAFT_WRITER_EMAIL=draft-writer@example.com
# Wrap the password in single quotes, e.g. DRAFT_WRITER_PASSWORD='...'
DRAFT_WRITER_PASSWORD=your_secure_password_here
